# =====================================================================
# NOVA Voice Assistant — Environment Configuration Template
# =====================================================================
# Copy this file to .env and fill in your actual API keys.
# NEVER commit the real .env file or any secrets to version control.
# =====================================================================

# --- Primary AI Provider API Keys (At least one required) ---
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
CEREBRAS_API_KEY=

# --- Search & Intelligence Services ---
TAVILY_API_KEY=
OPENWEATHER_API_KEY=
NEWS_API_KEY=
GOOGLE_MAPS_API_KEY=

# --- Voice & Speech Services (Optional / Engine Overrides) ---
ELEVENLABS_API_KEY=
STT_ENGINE=faster_whisper
TTS_ENGINE=edge
WHISPER_MODEL_NAME=base
STT_LANGUAGE=en
TTS_VOICE=en-US-JennyNeural

# --- Database & Persistence (Optional) ---
MONGODB_URI=

# --- System & Environment Configuration ---
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO
DEFAULT_BROWSER=chrome
